{
  "name": "@avow-finance/terminal",
  "version": "0.4.0",
  "description": "How Avow's command-line tools draw in a terminal: the banner, the step rail and set-apart lines",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avow-Finance/avow.git",
    "directory": "packages/terminal"
  },
  "devDependencies": {
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0"
  }
}
