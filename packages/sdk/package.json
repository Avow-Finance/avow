{
  "name": "@avow-finance/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK for agents making commitments backed by Avow reserves",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent-entry.d.ts",
      "node": "./dist/node-agent.js",
      "default": "./dist/agent-entry.js"
    },
    "./service": {
      "types": "./dist/service-entry.d.ts",
      "default": "./dist/service-entry.js"
    }
  },
  "bin": {
    "avow-sandbox": "./dist/node/cli.js",
    "avow-sandbox-mcp": "./dist/node/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avow-finance/avow.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "@avow-finance/spec": "workspace:*",
    "@avow-finance/terminal": "workspace:*",
    "@avow-finance/verifier": "workspace:*",
    "ox": "0.14.57",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
